[Unit]
Description=Parenting Together
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/parenting-together
EnvironmentFile=/etc/parenting-together.env
ExecStartPre=+/bin/bash /opt/parenting-together/deploy/prepare-database.sh
ExecStart=/bin/bash /opt/parenting-together/deploy/run-app.sh
TimeoutStartSec=900
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
